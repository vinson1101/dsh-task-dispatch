{
  "name": "dsh-task-dispatch",
  "version": "0.6.0",
  "description": "按工作空间给真实的 DSH 会话派发任务，带持久任务台账、只读结果查询与等待，零依赖",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/relay.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dispatch",
    "task",
    "workspace",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "vinson1101",
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
